server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 60m;

  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }

  # Same-origin API proxy: cookies stay first-party (SameSite=Lax) and no CORS/credentialed-wildcard is needed.
  location /api/ {
    set $backend "http://${BACKEND_HOSTPORT}";
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 120s;
    proxy_request_buffering on;
  }

  location /health {
    set $backend "http://${BACKEND_HOSTPORT}";
    proxy_pass $backend;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-store";
  }
}
