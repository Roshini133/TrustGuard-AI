# ============================================================================
# TrustGuard AI — environment configuration (copy to `.env`; NEVER commit `.env`)
# All values below are SAFE PLACEHOLDERS. Real secrets belong only in your local
# `.env` or in the Render dashboard. Nothing here is exposed to the browser build.
# ============================================================================

# --- Core -------------------------------------------------------------------
APP_ENV=development                 # development | production  (production enforces strict startup validation)
SERVICE_ROLE=api                    # api | worker
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-long-random-string
SESSION_SECRET=replace-with-long-random-string

# --- Database / cache -------------------------------------------------------
# docker compose overrides these for its own containers. Production: Render Postgres connection string.
DATABASE_URL=postgresql://trustguard:trustguard@localhost:5432/trustguard
REDIS_URL=redis://localhost:6379/0  # rate limiting + Celery broker (transient data only). Empty = in-memory fallback
JOBS_MODE=                          # celery | inline | sync. Empty = celery if REDIS_URL is set, else inline

# --- Public URLs (used to build reset links; never taken from request headers) ---
FRONTEND_URL=http://localhost:8080  # production: https://your-frontend.onrender.com (must be https, no trailing slash)
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8080  # comma-separated exact origins; '*' is rejected in production

# --- Transactional email (Resend) ---------------------------------------------
EMAIL_PROVIDER=resend               # 'resend' (default). 'console' = DEV ONLY, prints emails to API log; refused in production
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a sender permitted by Resend (a verified domain, or Resend's onboarding sender in testing)
EMAIL_FROM=TrustGuard AI <no-reply@your-verified-domain.example>

# --- OTP / password reset ---------------------------------------------------------
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5
PASSWORD_RESET_EXPIRY_SECONDS=900

# --- Sessions ------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_REFRESH_DAYS=30
FIRST_ADMIN_EMAIL=                  # the address that becomes `admin` when it registers (everyone else = analyst)

# --- Rate limiting  ("max requests / window seconds", per IP and per account) ---------------
RATE_LIMIT_REGISTER=5/3600
RATE_LIMIT_LOGIN=10/300
RATE_LIMIT_OTP_VERIFY=10/300
RATE_LIMIT_OTP_RESEND=5/3600
RATE_LIMIT_FORGOT=5/3600

# --- Artifact storage (datasets + model files; metadata/hashes live in PostgreSQL) --------------
ARTIFACT_STORAGE_BACKEND=local      # local | s3   (Render: use s3 — see README)
ARTIFACT_STORAGE_PATH=./artifacts   # local backend only; mount a persistent volume
S3_BUCKET=
S3_ENDPOINT_URL=                    # blank for AWS S3; Cloudflare R2 / Backblaze B2 / MinIO endpoint otherwise
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Misc ----------------------------------------------------------------------------------------------
MAX_UPLOAD_MB=50
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
CELERY_CONCURRENCY=2
